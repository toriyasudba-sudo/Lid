{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lid",
  "main": "./worker.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toriya-nova-mini-app",
      "database_id": "403bec72-57da-4777-9070-135b51767b33"
    }
  ],
  "vars": {
    "OWNER_CHAT_ID": "6894849502",
    "CHANNEL_ID": "@tori_ya_nova",
    "INIT_DATA_MAX_AGE_SEC": "86400",
    "MINI_APP_URL": "https://lid.toriya-sudba.workers.dev/",
    "CONSULTATION_URL": "https://t.me/toriya_nova"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
